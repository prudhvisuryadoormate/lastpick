rules_version = '2';

// Offer photos: public to read; each user uploads only into their own folder, images up to 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /offer-photos/{userId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
