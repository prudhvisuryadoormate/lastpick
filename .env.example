# Firebase web config for the LastPick project (Firebase console -> Project settings -> Your apps -> Web app).
# Leave VITE_FIREBASE_API_KEY empty to run LastPick in demo mode (data saved in the browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Functions region (must match functions/index.js)
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
