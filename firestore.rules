rules_version = '2';

// LastPick Firestore rules.
// Phone numbers are never readable directly by customers: they come from the lpRevealContact
// Cloud Function, which checks for an active Customer Pass. Subscriptions, leads, contact logs,
// photos, archive and city counters are written only by Cloud Functions (Admin SDK bypasses rules).
// Moderators (role "moderator") work through Cloud Functions that check their regions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }
    function ownerPlanActive() {
      return ownerTrial() || ownerSub();
    }
    // free month for a verified business (set by lpAdminSetBusinessStatus)
    function ownerTrial() {
      return exists(/databases/$(database)/documents/businesses/$(uid()))
        && get(/databases/$(database)/documents/businesses/$(uid())).data.get('trialEndsAt', timestamp.value(0)) > request.time;
    }
    function ownerSub() {
      return exists(/databases/$(database)/documents/subscriptions/$(uid() + '_owner'))
        && get(/databases/$(database)/documents/subscriptions/$(uid() + '_owner')).data.currentPeriodEnd > request.time
        && get(/databases/$(database)/documents/subscriptions/$(uid() + '_owner')).data.status in ['active', 'cancelled'];
    }
    // free-launch mode: no config yet, or config/app.freeMode != false
    function freeMode() {
      return !exists(/databases/$(database)/documents/config/app)
        || get(/databases/$(database)/documents/config/app).data.freeMode != false;
    }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---- users: own profile; role and email are fixed ----
    match /users/{userId} {
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow create: if signedIn() && userId == uid()
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'phone', 'email', 'role', 'createdAt']);
      allow update: if signedIn() && ((userId == uid() && onlyChanged(['name', 'phone', 'nameLower'])) || isAdmin());
    }

    // ---- subscriptions: read own; written only by Cloud Functions ----
    match /subscriptions/{subId} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ---- businesses: id = owner's uid. Status is set only by admins. ----
    match /businesses/{bizId} {
      allow read: if resource.data.status == 'verified' || (signedIn() && (bizId == uid() || isAdmin()));
      allow create: if signedIn() && bizId == uid()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        (bizId == uid() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'statusNote', 'ownerId', 'reportCount', 'reviewedBy', 'reviewedAt', 'rating', 'trialEndsAt'])
          && (!('categories' in request.resource.data) || (request.resource.data.categories is list && request.resource.data.categories.size() <= 3)))
        || isAdmin());
    }

    // ---- full-size offer photos (thumbnails live on the offer) ----
    match /offerPhotos/{offerId} {
      allow read: if true;
    }

    // ---- compact history of ended offers ----
    match /offerArchive/{offerId} {
      allow read: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }

    // ---- app settings (free-launch mode); written by lpAdminSetConfig ----
    match /config/{doc} {
      allow read: if true;
    }

    // ---- live-offer counters per city (for the city picker) ----
    match /cities/{cityKey} {
      allow read: if true;
    }

    // ---- private contact number of a business: owner and admins only ----
    match /businessContacts/{bizId} {
      allow read, write: if signedIn() && (bizId == uid() || isAdmin());
    }

    // ---- offers: created by the createOffer function ----
    match /offers/{offerId} {
      allow read: if (resource.data.visible == true && resource.data.status == 'live')
        || (signedIn() && (resource.data.ownerId == uid() || isAdmin()));
      allow update: if
        // a signed-in user may add one view (stops bots running up writes)
        (signedIn() && onlyChanged(['views']) && request.resource.data.views == resource.data.views + 1)
        // owner may end their offer
        || (signedIn() && resource.data.ownerId == uid() && onlyChanged(['status']) && request.resource.data.status == 'ended')
        || isAdmin();
    }

    // ---- leads: customers who shared their number. Owner sees them while Owner Pro is active. ----
    match /leads/{leadId} {
      allow read: if signedIn() && (resource.data.customerId == uid()
        || (resource.data.ownerId == uid() && (freeMode() || ownerPlanActive()))
        || isAdmin());
      allow update: if signedIn() && resource.data.ownerId == uid() && onlyChanged(['status'])
        && request.resource.data.status in ['new', 'contacted', 'closed'];
    }

    // ---- customer's "My contacts" log: read own; written by functions ----
    match /customerContacts/{id} {
      allow read: if signedIn() && (resource.data.customerId == uid() || isAdmin());
    }

    // ---- reviews: written only by Cloud Functions (lpSubmitReview / lpReplyReview) ----
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && (resource.data.customerId == uid() || resource.data.businessId == uid() || isAdmin()));
    }

    // ---- complaints / grievance tickets: created by lpSubmitGrievance ----
    match /grievances/{ticket} {
      allow read: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // auditLog, consentLog, rateLimits, deletedAccounts and otps have no rule, so apps can't read or write them.

    // ---- reports of misuse ----
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid() && request.resource.data.status == 'open'
        && request.resource.data.offerId is string && !('reviewId' in request.resource.data);
      allow read: if signedIn() && (resource.data.reporterId == uid() || isAdmin());
      allow update: if isAdmin();
    }
  }
}
